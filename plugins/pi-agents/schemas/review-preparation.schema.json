{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "execution_id": {
      "type": "string",
      "minLength": 1
    },
    "after_cursor": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "max_bytes": {
      "default": 32768,
      "type": "integer",
      "minimum": 8192,
      "maximum": 262144
    },
    "limit": {
      "default": 10,
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    }
  },
  "required": [
    "scope_id",
    "task_id",
    "execution_id",
    "max_bytes",
    "limit"
  ],
  "additionalProperties": false
}
