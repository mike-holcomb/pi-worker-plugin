{
  "name": "@mike-holcomb/pi-agents",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "bin": {
    "pi-agents": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "schemas": "npm run build && node dist/generate-schemas.js",
    "bundle": "npm run build && node scripts/bundle.mjs",
    "test": "node --test dist/test/*.test.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.5",
    "@earendil-works/pi-durable": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/chord": "1.5.0",
    "@earendil-works/pi-schema": "1.5.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "24.10.3",
    "esbuild": "0.28.2",
    "typescript": "6.0.2"
  }
}
